<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!--Disables checking for a required property, because we are testing one parameter at a time-->
    <!--And disable forcing internal, as test classes must be public-->
    <NoWarn>$(NoWarn);RZ2012;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Bunit" />
    <Using Include="Bunit.TestDoubles" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- bUnit 2.8.4-preview references AngleSharp 1.4.0 containing a moderate CVE -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="bunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Wader.Bootstrap\Wader.Bootstrap.csproj" />
  </ItemGroup>
</Project>
