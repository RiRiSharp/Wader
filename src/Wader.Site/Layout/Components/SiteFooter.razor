@using Wader.Bootstrap.Helpers
<footer class="border-top text-muted mt-3">
    <BsDisplayFlex Justify="BsJustification.Center">
        <div>
            &copy; @(DateTime.Now.Year) - Wader - v@(_version ?? "UNKNOWN")
        </div>
    </BsDisplayFlex>
</footer>

@code {
    private string? _version;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        SetVersion();
    }

    private void SetVersion()
    {
        _version = typeof(SiteFooter).Assembly.GetName().Version?.ToString();
    }
}