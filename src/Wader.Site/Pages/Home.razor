@page "/"
@using Wader.Bootstrap.Components.Buttons
@using Wader.Bootstrap.Components.Collapse
@using Wader.Bootstrap.Components.Dropdown
@using Wader.Bootstrap.Components.ListGroup
@using Wader.Bootstrap.Components.Offcanvas
@using Wader.Icons.Bootstrap
@using Wader.Icons.Phosphor

<PageTitle>Home</PageTitle>

<BsCollapse Show="true" @ref="_collapse">
    Hello world!
</BsCollapse>
<BsButton Variant="BsButtonVariant.Primary" @onclick="() => _collapse?.ToggleAsync() ?? Task.CompletedTask">Toggle
</BsButton>
<BsButton Variant="BsButtonVariant.Secondary" @onclick="() => _collapse?.ShowAsync() ?? Task.CompletedTask">Show
</BsButton>
<BsButtonOutline Variant="BsButtonOutlineVariant.Primary"
                 @onclick="() => _collapse?.CollapseAsync() ?? Task.CompletedTask">
    Hide
</BsButtonOutline>

<BsDropdown>
    <BsDropdownToggle OutlineVariant="BsButtonOutlineVariant.Primary" Size="BsButtonSize.Large">
        Dropdown button
    </BsDropdownToggle>
    <BsDropdownMenu>
        <BsDropdownItem>Action!</BsDropdownItem>
        <BsDropdownItem>Action2!</BsDropdownItem>
        <BsDropdownDivider/>
        <BsDropdownItem>Action3!</BsDropdownItem>
    </BsDropdownMenu>
</BsDropdown>

<BsListGroup>
    <BsListGroupItem ElType="BsListGroupItemType.Button" Variant="BsListGroupItemVariant.Primary">Super cool
    </BsListGroupItem>
    <BsListGroupItem ElType="BsListGroupItemType.Button" Variant="BsListGroupItemVariant.Primary">Super cool
    </BsListGroupItem>
    <BsListGroupItem ElType="BsListGroupItemType.Link" Variant="BsListGroupItemVariant.Success"
                     href="https://duckduckgo.com">Linkert
    </BsListGroupItem>
</BsListGroup>
<BsButton @onclick="() => _offcanvas!.ShowAsync()">Offcanvas!</BsButton>
<BsOffcanvas @ref="_offcanvas">
    <BsOffcanvasTitle>Title!</BsOffcanvasTitle>
    <BsOffcanvasBody>Body!</BsOffcanvasBody>
</BsOffcanvas>

<h3>
    Icons!
</h3>
<BsIcon Name="@(BsIconNames.Airplane)"/>
<PhosphorIcon Name="@(PhosphorIconNames.Airplane)"/>
<PhosphorIcon Name="@(PhosphorIconNames.Airplane)" Weight="PhosphorIconWeight.DuoTone"/>
<PhosphorIcon Name="@(PhosphorIconNames.Airplane)" Weight="PhosphorIconWeight.Light"/>

@code {
    private BsCollapse? _collapse;
    private BsOffcanvas? _offcanvas;
}
