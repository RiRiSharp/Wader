@using Wader.Bootstrap.Infrastructure.Constants
@inherits Wader.Bootstrap.BaseComponents.BsChildContentComponent
@if (_dismissed) return;
<div role="alert" @attributes="RenderAttributes" @ref="HtmlRef">
    <CascadingValue Value="AlertContext" Name="@(CascadingValueNames.ALERT_CONTEXT)">
        @(ChildContent)
    </CascadingValue>
</div>