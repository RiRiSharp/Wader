@inherits Wader.Bootstrap.BaseComponents.BsChildContentComponent
<div @ref="HostElementRef" @attributes="RenderAttributes">
    @(ChildContent)
</div>

@* These wrapper elements only exist to render the sent render fragments, without showing them to the user *@
@if (Title is not null)
{
    <div class="d-none" aria-hidden="true" @ref="_titleRef">
        @(Title)
    </div>
}

@if (Content is not null)
{
    <div class="d-none" aria-hidden="true" @ref="_contentRef">
        @(Content)
    </div>
}
