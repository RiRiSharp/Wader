@using Wader.Components.Buttons
@inherits Wader.BaseComponents.BsChildContentComponent

@if (Variant is not null)
{
    <BsButton Size="Size" Variant="Variant.Value" aria-expanded="false" @attributes="RenderAttributes" data-bs-toggle="dropdown">
        @(ChildContent)
    </BsButton>
}
else @* We've checked elsewhere that at least one of them is not null *@
{
    <BsButtonOutline Size="Size" Variant="OutlineVariant!.Value" aria-expanded="false" @attributes="RenderAttributes" data-bs-toggle="dropdown">
        @(ChildContent)
    </BsButtonOutline>
}