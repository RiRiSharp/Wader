@inherits Wader.BaseComponents.BsChildContentComponent

@switch (ButtonType)
{
    case BsButtonType.Button:
        <button type="button" @attributes="RenderAttributes" disabled="@(Disabled)" @ref="HtmlRef">
            @(ChildContent)
        </button>
        break;
    case BsButtonType.Link:
        <a role="button" @attributes="RenderAttributes" disabled="@(Disabled)" @ref="HtmlRef">
            @(ChildContent)
        </a>
        break;
    case BsButtonType.Label:
        <label @attributes="RenderAttributes" disabled="@(Disabled)" @ref="HtmlRef">
            @(ChildContent)
        </label>
        break;
    default:
            throw new ArgumentOutOfRangeException();
}
